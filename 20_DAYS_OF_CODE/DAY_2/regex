package main

import (
	"fmt"
	"regexp"
)

func Punc(text string) string {

	regpunc := regexp.MustCompile(`\s+([,.?:;!]+)\s+`)
	text = regpunc.ReplaceAllString(text, "$1")

	regAfter := regexp.MustCompile(`([.,:;?!])(\w+)`)
	text = regAfter.ReplaceAllString(text, `$1 $2`)

	regQuote := regexp.MustCompile(`'\s+(.*?)\s+'`)
	text = regQuote.ReplaceAllString(text, `'$1'`)

	return text
}

func main() {
	fmt.Println(Punc("when    , are , you coming  !      ?  !  '              awesome                  ' "))
}
